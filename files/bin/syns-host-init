#!/bin/sh
# Create this machine's Hyprland host file (~/.config/hypr/user/hosts/<hostname>.lua) from
# what's connected: monitors, and NVIDIA if it drives a display. (Keyboard is UK everywhere, in shared.lua.)
# Runs from the installer, and automatically at first login on a fresh install.
#   syns-host-init           create it if missing, then reload Hyprland
#   syns-host-init --force   overwrite an existing one (the old one is kept as .bak)
#   syns-host-init --print   print what would be written

HOST=$(cat /etc/hostname 2>/dev/null || hostname)
DIR="$HOME/.config/hypr/user/hosts"
FILE="$DIR/$HOST.lua"
mode=${1:-create}

if [ -f "$FILE" ] && [ "$mode" != "--force" ] && [ "$mode" != "--print" ]; then
    exit 0
fi
command -v hyprctl >/dev/null && command -v jq >/dev/null || { echo "needs hyprctl and jq" >&2; exit 1; }
[ -n "$HYPRLAND_INSTANCE_SIGNATURE" ] || {
    sig=$(ls -t "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr" 2>/dev/null | head -1)
    [ -n "$sig" ] && export HYPRLAND_INSTANCE_SIGNATURE="$sig"
}
mons=$(hyprctl monitors -j 2>/dev/null) || { echo "Hyprland isn't running" >&2; exit 1; }

# Internal panels first, then the rest by position
names=$(printf '%s' "$mons" | jq -r 'sort_by((.name | test("^(eDP|LVDS|DSI)") | not), .x, .y) | .[].name')
count=$(printf '%s\n' "$names" | grep -c .)

# NVIDIA: only when an NVIDIA card drives a connected display (not on Optimus laptops)
nvidia=false
for c in /sys/class/drm/card*-*; do
    [ "$(cat "$c/status" 2>/dev/null)" = connected ] || continue
    card=$(basename "$c"); card=${card%%-*}
    drv=$(basename "$(readlink -f "/sys/class/drm/$card/device/driver")" 2>/dev/null)
    [ "$drv" = nvidia ] && nvidia=true
done

out=$(
    echo "-- Machine-specific settings for $HOST (generated by syns-host-init; edit freely)."
    echo "-- hyprland.lua calls vars() right after CachyOS's variables, and setup() after everything else."
    echo
    echo "local M = {}"
    echo
    echo "function M.vars()"
    i=1
    for n in $names; do echo "    MONITOR$i = \"$n\""; i=$((i + 1)); done
    echo "    PRIMARY_MONITOR = MONITOR1"
    echo "end"
    echo
    echo "function M.setup()"
    if $nvidia; then
        echo
        echo "    -- NVIDIA drives a display here"
        echo "    hl.env(\"LIBVA_DRIVER_NAME\", \"nvidia\")"
        echo "    hl.env(\"__GLX_VENDOR_LIBRARY_NAME\", \"nvidia\")"
        echo "    hl.env(\"GBM_BACKEND\", \"nvidia-drm\")"
        echo "    hl.env(\"NVD_BACKEND\", \"direct\")"
    fi
    echo
    echo "    -- Monitors, matched by model so they work on any port (or use Monitor Settings)"
    printf '%s' "$mons" | jq -r '.[] | "    hl.monitor({ output = \"desc:\(.description)\", mode = \"\(.width)x\(.height)@\(.refreshRate * 100 | round / 100)\", position = \"auto-right\", scale = \(.scale) })"'
    echo "    hl.monitor({ output = \"\", mode = \"preferred\", position = \"auto-right\", scale = \"auto\" })"
    echo
    echo "    -- Workspaces 1-10 are split across whatever monitors are connected (user/shared.lua)"
    echo "end"
    echo
    echo "return M"
)

if [ "$mode" = "--print" ]; then printf '%s\n' "$out"; exit 0; fi
mkdir -p "$DIR"
[ -f "$FILE" ] && cp "$FILE" "$FILE.bak"
printf '%s\n' "$out" >"$FILE"
echo "Created $FILE ($count monitor(s)$($nvidia && echo ', NVIDIA'))"
hyprctl reload >/dev/null 2>&1 || true
